# Application
NODE_ENV=development
PORT=3000

# Database (MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/navigarde

# Forge / Manus storage API (used by storage, image generation, notifications, LLM)
# These can also be set via MANUS_API_URL / MANUS_API_KEY for backward compatibility.
FORGE_API_URL=
FORGE_API_KEY=
MANUS_API_URL=
MANUS_API_KEY=

# AI (Baseten)
BASETEN_API_KEY=

# AWS S3 (if used instead of Manus storage)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=