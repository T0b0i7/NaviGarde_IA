# Application
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Base de données MySQL / MariaDB
# -----------------------------------------------------------------------------
# IMPORTANT : jamais le compte root. L'application refuse de démarrer en
# production si DATABASE_URL pointe sur un superutilisateur.
# Le compte applicatif dispose uniquement de SELECT/INSERT/UPDATE/DELETE.
# Voir DEPLOYMENT.md, section « Compte MySQL dédié ».
# Exemple : mysql://navigarde_app:<mot-de-passe-urlencode>@127.0.0.1:3306/navigarde
DATABASE_URL=

# -----------------------------------------------------------------------------
# Compte de migration (CI et déploiement uniquement)
# -----------------------------------------------------------------------------
# Utilisé par `pnpm db:migrate`. Privilèges CREATE/ALTER/DROP nécessaires pour
# faire évoluer le schéma. Ne jamais réutiliser ce compte pour l'application.
MIGRATION_DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentification Manus (plateforme)
# -----------------------------------------------------------------------------
MANUS_PROJECT_ID=
# Secret de signature des sessions : minimum 32 caractères en production.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
OWNER_OPEN_ID=

# -----------------------------------------------------------------------------
# Analyse IA (Baseten)
# -----------------------------------------------------------------------------
# Sans clé, les fonctions IA renvoient une erreur explicite — jamais une
# simulation présentée comme une analyse réelle.
BASETEN_API_KEY=

# -----------------------------------------------------------------------------
# Observabilité
# -----------------------------------------------------------------------------
# Niveau de log pino : trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Durée au-delà de laquelle une requête est journalisée en avertissement
SLOW_REQUEST_MS=1500
# Jeton requis pour lire /api/metrics en production (absent = 401 en prod)
METRICS_TOKEN=

# -----------------------------------------------------------------------------
# Stockage (S3 optionnel, sinon /public/uploads local en développement)
# -----------------------------------------------------------------------------
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
