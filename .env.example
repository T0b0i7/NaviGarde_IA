# ---------------------------------------------------------------------------
# NaviGarde IA — variables d'environnement (modèle)
# Copier en `.env` et renseigner. Ne jamais commiter `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# === PostgreSQL =============================================================
PGUSER=postgres
PGHOST=localhost
PGPASSWORD=votre_mot_de_passe
PGDATABASE=navigarde_db
PGPORT=5432

# Persistance : `false` => aucune écriture en base, tout reste en mémoire.
DB_ENABLED=true
# Persistance obligatoire : si true, une base injoignable renvoie 503 au lieu de
# dégrader. Par défaut : true en production, false ailleurs.
# DB_REQUIRED=false

PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=1500
DB_RETRY_AFTER_MS=30000

# === IA =====================================================================
# `mock` : aucun appel réseau, données déterministes (démo de secours, T14).
# `meta` : appels réels vers les endpoints ci-dessous.
AI_PROVIDER=mock

# Scénario du mock : critical | compliant | blurred
MOCK_SCENARIO=critical

# Identifiants Meta Model API
META_MODEL_API_TEAM_ID=3554062628092959
META_API_KEY=

# Endpoints d'inférence (à confirmer jour 1 dans la doc du hackathon)
SAM3_ENDPOINT=
MUSE_SPARK_ENDPOINT=
MUSE_VOICE_ENDPOINT=
MUSE_WONDER_ENDPOINT=

# Réseau / robustesse
AI_TIMEOUT_MS=20000

# === Règles métier ==========================================================
CONFIDENCE_THRESHOLD=0.6

# === Uploads ================================================================
MAX_IMAGE_MB=10
MAX_AUDIO_MB=15
UPLOAD_DIR=./storage/uploads
# URL publique utilisée dans le QR code de vérification des rapports PDF.
PUBLIC_BASE_URL=http://localhost:3000

# === Module audio / alertes vocales =========================================
MUSE_SPARK_OPEN_ENDPOINT=
# Jeton exigé sur /voice-alert dès qu'il est défini (laisser vide en démo).
ALERT_TOKEN=
ALERT_RATE_LIMIT=10
ALERT_RATE_WINDOW_MS=600000
